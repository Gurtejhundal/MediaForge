# Optional. Feedback is not sent unless a webhook is configured.
# Use your own Discord, Slack, or generic JSON webhook. Never commit its real URL.
MEDIAFORGE_REPORT_WEBHOOK_URL=

# Optional. Trusted, operator-selected public Cobalt-compatible endpoint.
# Without one, direct public media links still work; platform links return 503.
MEDIAFORGE_DOWNLOADER_URL=

# Build/runtime telemetry preference. Packaged desktop builds always disable this.
NEXT_TELEMETRY_DISABLED=1
