{
  "name": "mediaforge",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/prepare-web.cjs",
    "start": "node scripts/start.cjs",
    "lint": "eslint src desktop scripts tests next.config.ts eslint.config.mjs playwright.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/test-loader.mjs --test tests/unit/*.test.*",
    "test:e2e": "playwright test",
    "desktop:prepare": "node scripts/prepare-desktop.cjs",
    "desktop:start": "electron desktop-app",
    "desktop:pack": "npm run build && npm run desktop:prepare && electron-builder --dir --publish never",
    "desktop:dist": "npm run build && npm run desktop:prepare && electron-builder --publish never",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "release:checksums": "node scripts/checksums.cjs",
    "audit:dependencies": "node scripts/audit-dependencies.cjs",
    "android:web": "node scripts/build-android-web.cjs",
    "android:apk": "npm run android:web && cd android && ./gradlew :app:assemblePreview --no-daemon"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@imgly/background-removal": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "^1.21.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.32",
    "uuid": "11.1.1",
    "image-size": "2.1.0",
    "minimatch": "11.0.5"
  },
  "description": "A local media workbench for images, video, audio, documents, QR codes and favicons.",
  "homepage": "https://mediaforge-tau.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gurtejhundal/MediaForge.git"
  },
  "author": {
    "name": "Gurtejbir Singh",
    "email": "149035823+Gurtejhundal@users.noreply.github.com"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "type": "module",
  "desktopName": "MediaForge",
  "license": "AGPL-3.0-only"
}
